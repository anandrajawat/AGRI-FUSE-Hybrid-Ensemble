# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Force specific text formats
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.txt text eol=lf

# Explicitly mark binaries
*.joblib binary
*.pth binary
*.pt binary
*.npy binary
*.npz binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.xls binary
*.xlsx binary
*.zip binary
